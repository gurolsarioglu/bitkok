<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" class="navbar__logo">
          <% if (content.settings.logo) { %>
            <img src="<%= content.settings.logo %>" alt="<%= content.settings.siteName %>" class="navbar__logo-icon" style="width:40px;height:40px;object-fit:contain;">
          <% } else { %>
            <svg class="navbar__logo-icon" viewBox="0 0 40 40" fill="none">
              <path d="M20 4C16 4 12 8 12 14c0 4 1 8 4 11 1.5 1.5 3 2.5 4 3v4" stroke="#83C5BE" stroke-width="2" fill="none"/>
              <path d="M14 10c-2 2-3 5-3 8 0 3 1 6 3 8" stroke="#4F6D7A" stroke-width="2.5" fill="none" stroke-linecap="round"/>
              <path d="M17 7c-1 2-2 5-2 8s1 6 2 8" stroke="#4F6D7A" stroke-width="2" fill="none" stroke-linecap="round"/>
              <circle cx="24" cy="10" r="1.5" fill="#83C5BE"/><circle cx="27" cy="14" r="1.5" fill="#83C5BE"/><circle cx="25" cy="18" r="1.5" fill="#83C5BE"/>
              <path d="M20 14h6M20 18h8M20 22h5" stroke="#1B263B" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          <% } %>
          <span class="navbar__logo-text"><%= content.settings.siteName %><span><%= content.settings.siteDomain %></span></span>
        </a>
        <p><%= content.footer.description %></p>
      </div>
      <div>
        <h4 class="footer__heading">Hızlı Linkler</h4>
        <ul class="footer__links">
          <% content.footer.quickLinks.forEach(link => { %>
            <li><a href="<%= link.href %>"><%= link.label %></a></li>
          <% }) %>
        </ul>
      </div>
      <div>
        <h4 class="footer__heading">Hizmetler</h4>
        <ul class="footer__links">
          <% content.footer.services.forEach(link => { %>
            <li><a href="<%= link.href %>"><%= link.label %></a></li>
          <% }) %>
        </ul>
      </div>
      <div>
        <h4 class="footer__heading">Takip Edin</h4>
        <div class="footer__social">
          <a href="<%= content.settings.socialMedia.linkedin %>" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-4 0v7h-4v-7a6 6 0 016-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></a>
          <a href="<%= content.settings.socialMedia.instagram %>" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg></a>
          <a href="<%= content.settings.socialMedia.twitter %>" aria-label="Twitter"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 3a10.9 10.9 0 01-3.14 1.53A4.48 4.48 0 0012 7.5v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/></svg></a>
        </div>
      </div>
    </div>
    <div class="footer__bottom">
      <p><%= content.footer.copyright %></p>
      <a href="/admin" class="footer__admin-link" title="Yönetim Paneli">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
      </a>
    </div>
  </div>
</footer>
