<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bitkok Admin — Giriş</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="login-page">
  <div class="login-container">
    <div class="login-card">
      <div class="login-header">
        <svg viewBox="0 0 40 40" fill="none" width="48" height="48">
          <path d="M20 4C16 4 12 8 12 14c0 4 1 8 4 11 1.5 1.5 3 2.5 4 3v4" stroke="#83C5BE" stroke-width="2" fill="none"/>
          <path d="M14 10c-2 2-3 5-3 8 0 3 1 6 3 8" stroke="#4F6D7A" stroke-width="2.5" fill="none" stroke-linecap="round"/>
          <path d="M17 7c-1 2-2 5-2 8s1 6 2 8" stroke="#4F6D7A" stroke-width="2" fill="none" stroke-linecap="round"/>
          <circle cx="24" cy="10" r="1.5" fill="#83C5BE"/><circle cx="27" cy="14" r="1.5" fill="#83C5BE"/><circle cx="25" cy="18" r="1.5" fill="#83C5BE"/>
          <path d="M20 14h6M20 18h8M20 22h5" stroke="#1B263B" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <h1>Bitkok Admin</h1>
        <p>Yönetim paneline giriş yapın</p>
      </div>
      <% if (error) { %>
        <div class="login-error"><%= error %></div>
      <% } %>
      <form method="POST" action="/admin/login">
        <div class="form-group">
          <label for="username">Kullanıcı Adı</label>
          <input type="text" id="username" name="username" placeholder="admin" required autofocus>
        </div>
        <div class="form-group">
          <label for="password">Şifre</label>
          <input type="password" id="password" name="password" placeholder="••••••••" required>
        </div>
        <button type="submit" class="btn-login">GİRİŞ YAP</button>
      </form>
    </div>
  </div>
</body>
</html>
