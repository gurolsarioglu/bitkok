<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bitkok Admin — Yönetim Paneli</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-page">
  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar__header">
      <% if (content.settings.logo) { %>
        <img src="<%= content.settings.logo %>" alt="Bitkok" style="width:32px;height:32px;object-fit:contain;border-radius:6px;">
      <% } else { %>
        <svg viewBox="0 0 40 40" fill="none" width="32" height="32">
          <path d="M20 4C16 4 12 8 12 14c0 4 1 8 4 11 1.5 1.5 3 2.5 4 3v4" stroke="#83C5BE" stroke-width="2" fill="none"/>
          <path d="M14 10c-2 2-3 5-3 8 0 3 1 6 3 8" stroke="#4F6D7A" stroke-width="2.5" fill="none" stroke-linecap="round"/>
          <circle cx="24" cy="10" r="1.5" fill="#83C5BE"/><circle cx="27" cy="14" r="1.5" fill="#83C5BE"/>
          <path d="M20 14h6M20 18h8" stroke="#1B263B" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      <% } %>
      <span>Bitkok Admin</span>
    </div>
    <nav class="sidebar__nav">
      <a href="/admin" class="sidebar__link <%= section === 'overview' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        Genel Bakış
      </a>
      <a href="/admin/edit/settings" class="sidebar__link <%= section === 'settings' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v4m0 14v4M4.22 4.22l2.83 2.83m9.9 9.9l2.83 2.83M1 12h4m14 0h4M4.22 19.78l2.83-2.83m9.9-9.9l2.83-2.83"/></svg>
        Site Ayarları
      </a>
      <a href="/admin/edit/design" class="sidebar__link <%= section === 'design' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2.69l5.66 5.66a8 8 0 11-11.31 0z"/></svg>
        Tasarım Sistemi
      </a>
      <a href="/admin/edit/hero" class="sidebar__link <%= section === 'hero' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2"/><path d="M7 2v20M2 12h5"/></svg>
        Hero Bölümü
      </a>
      <a href="/admin/edit/solutions" class="sidebar__link <%= section === 'solutions' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v6m0 8v6M2 12h6m8 0h6"/><circle cx="12" cy="12" r="3"/></svg>
        Çözümlerimiz
      </a>
      <a href="/admin/edit/story" class="sidebar__link <%= section === 'story' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
        Hikayemiz
      </a>
      <a href="/admin/edit/research" class="sidebar__link <%= section === 'research' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        Araştırma
      </a>
      <a href="/admin/edit/blog" class="sidebar__link <%= section === 'blog' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        Blog
      </a>
      <a href="/admin/edit/contact" class="sidebar__link <%= section === 'contact' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        İletişim
      </a>
    </nav>
    <div class="sidebar__divider"></div>
    <div class="sidebar__section-label">YÖNETİM</div>
    <nav class="sidebar__nav" style="padding-top:0">
      <a href="/admin/edit/security" class="sidebar__link <%= section === 'security' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Güvenlik
      </a>
    </nav>
    <div class="sidebar__footer">
      <a href="/" target="_blank" class="sidebar__link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15,3 21,3 21,9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        Siteyi Görüntüle
      </a>
      <a href="/admin/logout" class="sidebar__link sidebar__link--danger">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16,17 21,12 16,7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Çıkış Yap
      </a>
    </div>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="admin-main">
    <header class="admin-topbar">
      <button class="sidebar-toggle" id="sidebarToggle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <h2 class="admin-topbar__title">
        <% if (section === 'overview') { %>Genel Bakış
        <% } else if (section === 'settings') { %>Site Ayarları
        <% } else if (section === 'hero') { %>Hero Bölümü
        <% } else if (section === 'solutions') { %>Çözümlerimiz
        <% } else if (section === 'story') { %>Hikayemiz
        <% } else if (section === 'research') { %>Araştırma
        <% } else if (section === 'blog') { %>Blog Yönetimi
        <% } else if (section === 'contact') { %>İletişim
        <% } else if (section === 'design') { %>Tasarım Sistemi
        <% } else if (section === 'security') { %>Güvenlik
        <% } %>
      </h2>
      <div class="admin-topbar__user">
        <span>Hoşgeldin, <strong><%= admin.username %></strong></span>
      </div>
    </header>

    <div class="admin-content" id="adminContent">
      <!-- OVERVIEW -->
      <% if (section === 'overview') { %>
        <div class="overview-grid">
          <a href="/admin/edit/hero" class="overview-card">
            <h3>🏠 Hero</h3>
            <p>Başlık, açıklama ve hero görseli</p>
          </a>
          <a href="/admin/edit/solutions" class="overview-card">
            <h3>🛠️ Çözümler</h3>
            <p><%= content.solutions.items.length %> çözüm kartı</p>
          </a>
          <a href="/admin/edit/story" class="overview-card">
            <h3>📖 Hikaye</h3>
            <p>Kuruluş hikayesi ve istatistikler</p>
          </a>
          <a href="/admin/edit/blog" class="overview-card">
            <h3>📝 Blog</h3>
            <p><%= content.blog.posts.length %> blog yazısı</p>
          </a>
          <a href="/admin/edit/contact" class="overview-card">
            <h3>📞 İletişim</h3>
            <p>İletişim bilgileri</p>
          </a>
          <a href="/admin/edit/settings" class="overview-card">
            <h3>⚙️ Ayarlar</h3>
            <p>Logo, site adı, sosyal medya</p>
          </a>
          <a href="/admin/edit/design" class="overview-card" style="border-left:3px solid #83C5BE">
            <h3>🎨 Tasarım Sistemi</h3>
            <p>Fontlar, renkler, spacing, efektler</p>
          </a>
        </div>

      <!-- SETTINGS -->
      <% } else if (section === 'settings') { %>
        <form class="edit-form" data-section="settings">
          <div class="form-section">
            <h3>Logo</h3>
            <div class="image-upload-area">
              <% if (content.settings.logo) { %>
                <img src="<%= content.settings.logo %>" alt="Logo" class="preview-image" id="logoPreview">
              <% } else { %>
                <div class="preview-placeholder" id="logoPreview">Logo yüklenmemiş</div>
              <% } %>
              <input type="file" id="logoFile" accept="image/*" class="file-input">
              <label for="logoFile" class="btn-upload">Logo Yükle</label>
            </div>
          </div>
          <div class="form-section">
            <h3>Site Bilgileri</h3>
            <div class="form-row">
              <div class="form-group">
                <label>Site Adı</label>
                <input type="text" name="siteName" value="<%= content.settings.siteName %>">
              </div>
              <div class="form-group">
                <label>Domain</label>
                <input type="text" name="siteDomain" value="<%= content.settings.siteDomain %>">
              </div>
            </div>
            <div class="form-group">
              <label>Slogan</label>
              <input type="text" name="siteTagline" value="<%= content.settings.siteTagline %>">
            </div>
            <div class="form-group">
              <label>Meta Açıklama</label>
              <textarea name="metaDescription" rows="3"><%= content.settings.metaDescription %></textarea>
            </div>
          </div>
          <div class="form-section">
            <h3>Sosyal Medya</h3>
            <div class="form-group">
              <label>LinkedIn</label>
              <input type="text" name="social_linkedin" value="<%= content.settings.socialMedia.linkedin %>">
            </div>
            <div class="form-group">
              <label>Instagram</label>
              <input type="text" name="social_instagram" value="<%= content.settings.socialMedia.instagram %>">
            </div>
            <div class="form-group">
              <label>Twitter</label>
              <input type="text" name="social_twitter" value="<%= content.settings.socialMedia.twitter %>">
            </div>
          </div>
          <button type="submit" class="btn-save">💾 Kaydet</button>
        </form>

      <!-- HERO -->
      <% } else if (section === 'hero') { %>
        <form class="edit-form" data-section="hero">
          <div class="form-section">
            <h3>Hero Görseli</h3>
            <div class="image-upload-area">
              <img src="<%= content.hero.image %>" alt="Hero" class="preview-image" id="heroPreview">
              <input type="file" id="heroFile" accept="image/*" class="file-input" data-category="hero">
              <label for="heroFile" class="btn-upload">Görsel Değiştir</label>
            </div>
          </div>
          <div class="form-section">
            <h3>Başlık</h3>
            <div class="form-group">
              <label>Satır 1</label>
              <input type="text" name="titleLine1" value="<%= content.hero.titleLine1 %>">
            </div>
            <div class="form-group">
              <label>Vurgulu Kelime</label>
              <input type="text" name="titleHighlight" value="<%= content.hero.titleHighlight %>">
            </div>
            <div class="form-group">
              <label>Satır 2</label>
              <input type="text" name="titleLine2" value="<%= content.hero.titleLine2 %>">
            </div>
          </div>
          <div class="form-section">
            <h3>İçerik</h3>
            <div class="form-group">
              <label>Alt Yazı</label>
              <textarea name="subtitle" rows="3"><%= content.hero.subtitle %></textarea>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Buton Metni</label>
                <input type="text" name="ctaText" value="<%= content.hero.ctaText %>">
              </div>
              <div class="form-group">
                <label>Buton Linki</label>
                <input type="text" name="ctaLink" value="<%= content.hero.ctaLink %>">
              </div>
            </div>
          </div>
          <button type="submit" class="btn-save">💾 Kaydet</button>
        </form>

      <!-- SOLUTIONS -->
      <% } else if (section === 'solutions') { %>
        <form class="edit-form" data-section="solutions">
          <div class="form-section">
            <h3>Bölüm Başlığı</h3>
            <div class="form-group">
              <label>Etiket</label>
              <input type="text" name="label" value="<%= content.solutions.label %>">
            </div>
            <div class="form-group">
              <label>Başlık</label>
              <input type="text" name="title" value="<%= content.solutions.title %>">
            </div>
            <div class="form-group">
              <label>Açıklama</label>
              <textarea name="description" rows="2"><%= content.solutions.description %></textarea>
            </div>
          </div>
          <% content.solutions.items.forEach((item, i) => { %>
            <div class="form-section card-edit">
              <h3>Kart <%= i + 1 %>: <%= item.title %></h3>
              <div class="form-group">
                <label>Başlık</label>
                <input type="text" name="items[<%= i %>].title" value="<%= item.title %>">
              </div>
              <div class="form-group">
                <label>Açıklama</label>
                <textarea name="items[<%= i %>].desc" rows="2"><%= item.desc %></textarea>
              </div>
            </div>
          <% }) %>
          <button type="submit" class="btn-save">💾 Kaydet</button>
        </form>

      <!-- STORY -->
      <% } else if (section === 'story') { %>
        <form class="edit-form" data-section="story">
          <div class="form-section">
            <h3>Hikaye Görseli</h3>
            <div class="image-upload-area">
              <img src="<%= content.story.image %>" alt="Hikaye" class="preview-image" id="storyPreview">
              <input type="file" id="storyFile" accept="image/*" class="file-input" data-category="story">
              <label for="storyFile" class="btn-upload">Görsel Değiştir</label>
            </div>
          </div>
          <div class="form-section">
            <h3>Başlık</h3>
            <div class="form-group">
              <label>Etiket</label>
              <input type="text" name="label" value="<%= content.story.label %>">
            </div>
            <div class="form-group">
              <label>Başlık</label>
              <input type="text" name="title" value="<%= content.story.title %>">
            </div>
          </div>
          <div class="form-section">
            <h3>Paragraflar</h3>
            <% content.story.paragraphs.forEach((p, i) => { %>
              <div class="form-group">
                <label>Paragraf <%= i + 1 %></label>
                <textarea name="paragraphs[<%= i %>]" rows="3"><%= p %></textarea>
              </div>
            <% }) %>
          </div>
          <div class="form-section">
            <h3>İstatistikler</h3>
            <% content.story.stats.forEach((stat, i) => { %>
              <div class="form-row">
                <div class="form-group">
                  <label>Sayı</label>
                  <input type="number" name="stats[<%= i %>].number" value="<%= stat.number %>">
                </div>
                <div class="form-group">
                  <label>Etiket</label>
                  <input type="text" name="stats[<%= i %>].label" value="<%= stat.label %>">
                </div>
              </div>
            <% }) %>
          </div>
          <button type="submit" class="btn-save">💾 Kaydet</button>
        </form>

      <!-- RESEARCH -->
      <% } else if (section === 'research') { %>
        <form class="edit-form" data-section="research">
          <div class="form-section">
            <h3>Bölüm Başlığı</h3>
            <div class="form-group"><label>Başlık</label><input type="text" name="title" value="<%= content.research.title %>"></div>
            <div class="form-group"><label>Açıklama</label><textarea name="description" rows="2"><%= content.research.description %></textarea></div>
          </div>
          <% content.research.milestones.forEach((ms, i) => { %>
            <div class="form-section card-edit">
              <h3>Kilometre Taşı <%= i + 1 %></h3>
              <div class="form-row">
                <div class="form-group"><label>Yıl</label><input type="text" name="milestones[<%= i %>].year" value="<%= ms.year %>"></div>
                <div class="form-group"><label>Başlık</label><input type="text" name="milestones[<%= i %>].title" value="<%= ms.title %>"></div>
              </div>
              <div class="form-group"><label>Açıklama</label><textarea name="milestones[<%= i %>].desc" rows="2"><%= ms.desc %></textarea></div>
            </div>
          <% }) %>
          <button type="submit" class="btn-save">💾 Kaydet</button>
        </form>

      <!-- BLOG -->
      <% } else if (section === 'blog') { %>
        <form class="edit-form" data-section="blog">
          <div class="form-section">
            <h3>Bölüm Başlığı</h3>
            <div class="form-group"><label>Başlık</label><input type="text" name="title" value="<%= content.blog.title %>"></div>
          </div>
          <% content.blog.posts.forEach((post, i) => { %>
            <div class="form-section card-edit">
              <h3>Yazı <%= i + 1 %>: <%= post.title %></h3>
              <div class="image-upload-area small">
                <img src="<%= post.image %>" alt="" class="preview-image" id="blogPreview<%= i %>">
                <input type="file" id="blogFile<%= i %>" accept="image/*" class="file-input" data-category="blog" data-index="<%= i %>">
                <label for="blogFile<%= i %>" class="btn-upload">Görsel Değiştir</label>
              </div>
              <div class="form-row">
                <div class="form-group"><label>Etiket</label><input type="text" name="posts[<%= i %>].tag" value="<%= post.tag %>"></div>
                <div class="form-group"><label>Tarih</label><input type="text" name="posts[<%= i %>].date" value="<%= post.date %>"></div>
              </div>
              <div class="form-group"><label>Başlık</label><input type="text" name="posts[<%= i %>].title" value="<%= post.title %>"></div>
              <div class="form-group"><label>Özet</label><textarea name="posts[<%= i %>].excerpt" rows="2"><%= post.excerpt %></textarea></div>
            </div>
          <% }) %>
          <button type="submit" class="btn-save">💾 Kaydet</button>
        </form>

      <!-- CONTACT -->
      <% } else if (section === 'contact') { %>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px">
          <!-- Sol Kolon: İletişim Bilgileri -->
          <div>
            <form class="edit-form" data-section="contact">
              <div class="form-section">
                <h3>📋 Bölüm Başlığı</h3>
                <div class="form-group"><label>Etiket</label><input type="text" name="label" value="<%= content.contact.label %>"></div>
                <div class="form-group"><label>Başlık</label><input type="text" name="title" value="<%= content.contact.title %>"></div>
                <div class="form-group"><label>Açıklama</label><textarea name="description" rows="2"><%= content.contact.description %></textarea></div>
              </div>
              <% content.contact.details.forEach((d, i) => { %>
                <div class="form-section card-edit">
                  <h3><%= d.label %></h3>
                  <div class="form-row">
                    <div class="form-group">
                      <label>Etiket</label>
                      <input type="text" name="details[<%= i %>].label" value="<%= d.label %>">
                    </div>
                    <div class="form-group">
                      <label>İkon</label>
                      <select name="details[<%= i %>].icon">
                        <option value="location" <%= d.icon==='location'?'selected':'' %>>📍 Konum</option>
                        <option value="phone" <%= d.icon==='phone'?'selected':'' %>>📞 Telefon</option>
                        <option value="email" <%= d.icon==='email'?'selected':'' %>>📧 E-posta</option>
                      </select>
                    </div>
                  </div>
                  <div class="form-group"><label>Değer</label><input type="text" name="details[<%= i %>].value" value="<%= d.value %>"></div>
                </div>
              <% }) %>
              <button type="submit" class="btn-save">💾 İletişim Bilgilerini Kaydet</button>
            </form>

            <!-- E-posta Ayarları -->
            <% const emailSettings = (content.contact && content.contact.emailSettings) || {}; %>
            <form class="edit-form" data-section="contact" id="emailSettingsForm" style="margin-top:24px">
              <div class="form-section" style="border-left:3px solid #E0A96D">
                <h3>📧 E-posta Gönderim Ayarları (SMTP)</h3>
                <p style="color:var(--white-60);font-size:0.82rem;margin-bottom:16px">İletişim formundan gelen mesajların e-postanıza ulaşması için SMTP ayarlarını yapılandırın. Gmail için: smtp.gmail.com / 587 / Uygulama Şifresi</p>
                <div class="form-row">
                  <div class="form-group">
                    <label>SMTP Sunucu</label>
                    <input type="text" name="emailSettings.smtpHost" value="<%= emailSettings.smtpHost || '' %>" placeholder="smtp.gmail.com">
                  </div>
                  <div class="form-group">
                    <label>Port</label>
                    <input type="text" name="emailSettings.smtpPort" value="<%= emailSettings.smtpPort || '587' %>" placeholder="587">
                  </div>
                </div>
                <div class="form-row">
                  <div class="form-group">
                    <label>SMTP Kullanıcı</label>
                    <input type="text" name="emailSettings.smtpUser" value="<%= emailSettings.smtpUser || '' %>" placeholder="email@gmail.com">
                  </div>
                  <div class="form-group">
                    <label>SMTP Şifre</label>
                    <input type="password" name="emailSettings.smtpPass" value="<%= emailSettings.smtpPass || '' %>" placeholder="Uygulama şifresi">
                  </div>
                </div>
                <div class="form-row">
                  <div class="form-group">
                    <label>Alıcı E-posta</label>
                    <input type="email" name="emailSettings.recipientEmail" value="<%= emailSettings.recipientEmail || '' %>" placeholder="info@bitkok.com">
                  </div>
                  <div class="form-group">
                    <label>Gönderen Adı</label>
                    <input type="text" name="emailSettings.senderName" value="<%= emailSettings.senderName || 'Bitkok İletişim Formu' %>" placeholder="Bitkok İletişim Formu">
                  </div>
                </div>
                <div style="display:flex;gap:12px;align-items:center">
                  <button type="submit" class="btn-save">💾 SMTP Ayarlarını Kaydet</button>
                  <button type="button" class="btn-save" id="testEmailBtn" style="background:var(--sprout);color:var(--navy)">📤 Test Maili Gönder</button>
                </div>
              </div>
            </form>
          </div>

          <!-- Sağ Kolon: Gelen Mesajlar -->
          <div>
            <div class="form-section" style="border-left:3px solid var(--sprout)">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
                <h3>📬 Gelen Mesajlar</h3>
                <button class="btn-save" id="refreshMessages" style="padding:6px 16px;font-size:0.8rem">🔄 Yenile</button>
              </div>
              <div id="messagesContainer" style="display:flex;flex-direction:column;gap:12px;max-height:600px;overflow-y:auto">
                <div style="text-align:center;color:var(--white-60);padding:40px 0">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48" style="opacity:0.3;margin-bottom:12px"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                  <p>Mesajlar yükleniyor...</p>
                </div>
              </div>
            </div>
          </div>
        </div>

      <!-- DESIGN SYSTEM -->
      <% } else if (section === 'design') { %>
        <% const ds = content.design || {}; const fonts = ds.fonts || {}; const colors = ds.colors || {}; const typo = ds.typography || {}; const spacing = ds.spacing || {}; const borders = ds.borders || {}; const effects = ds.effects || {}; %>
        <form class="edit-form" data-section="design" id="designForm">

          <!-- FONTS -->
          <div class="form-section" style="border-left:3px solid #83C5BE">
            <h3>🔤 Yazı Tipleri (Google Fonts)</h3>
            <p style="color:var(--white-60);font-size:0.82rem;margin-bottom:16px">Kurumsal kimlik çalışmanızda belirlediğiniz fontları seçin. Tüm Google Fonts desteklenir.</p>
            <div class="form-row" style="grid-template-columns:1fr 1fr 1fr">
              <div class="form-group">
                <label>Başlık Fontu</label>
                <select name="fonts.heading" class="font-select" data-preview="heading-preview">
                  <option value="Playfair Display" <%= fonts.heading==='Playfair Display'?'selected':'' %>>Playfair Display</option>
                  <option value="Cormorant Garamond" <%= fonts.heading==='Cormorant Garamond'?'selected':'' %>>Cormorant Garamond</option>
                  <option value="Merriweather" <%= fonts.heading==='Merriweather'?'selected':'' %>>Merriweather</option>
                  <option value="Lora" <%= fonts.heading==='Lora'?'selected':'' %>>Lora</option>
                  <option value="DM Serif Display" <%= fonts.heading==='DM Serif Display'?'selected':'' %>>DM Serif Display</option>
                  <option value="Poppins" <%= fonts.heading==='Poppins'?'selected':'' %>>Poppins</option>
                  <option value="Montserrat" <%= fonts.heading==='Montserrat'?'selected':'' %>>Montserrat</option>
                  <option value="Raleway" <%= fonts.heading==='Raleway'?'selected':'' %>>Raleway</option>
                  <option value="Outfit" <%= fonts.heading==='Outfit'?'selected':'' %>>Outfit</option>
                  <option value="Inter" <%= fonts.heading==='Inter'?'selected':'' %>>Inter</option>
                </select>
                <div class="font-preview" id="heading-preview" style="font-size:1.4rem;margin-top:8px;font-weight:700">Aa Başlık</div>
              </div>
              <div class="form-group">
                <label>Gövde Fontu</label>
                <select name="fonts.body" class="font-select" data-preview="body-preview">
                  <option value="Inter" <%= fonts.body==='Inter'?'selected':'' %>>Inter</option>
                  <option value="Open Sans" <%= fonts.body==='Open Sans'?'selected':'' %>>Open Sans</option>
                  <option value="Roboto" <%= fonts.body==='Roboto'?'selected':'' %>>Roboto</option>
                  <option value="Nunito" <%= fonts.body==='Nunito'?'selected':'' %>>Nunito</option>
                  <option value="Source Sans 3" <%= fonts.body==='Source Sans 3'?'selected':'' %>>Source Sans 3</option>
                  <option value="DM Sans" <%= fonts.body==='DM Sans'?'selected':'' %>>DM Sans</option>
                  <option value="Poppins" <%= fonts.body==='Poppins'?'selected':'' %>>Poppins</option>
                  <option value="Lato" <%= fonts.body==='Lato'?'selected':'' %>>Lato</option>
                  <option value="Outfit" <%= fonts.body==='Outfit'?'selected':'' %>>Outfit</option>
                  <option value="Montserrat" <%= fonts.body==='Montserrat'?'selected':'' %>>Montserrat</option>
                </select>
                <div class="font-preview" id="body-preview" style="font-size:1rem;margin-top:8px">Aa Gövde metni örneği</div>
              </div>
              <div class="form-group">
                <label>Logo Fontu</label>
                <select name="fonts.logo" class="font-select" data-preview="logo-preview">
                  <option value="Montserrat" <%= fonts.logo==='Montserrat'?'selected':'' %>>Montserrat</option>
                  <option value="Poppins" <%= fonts.logo==='Poppins'?'selected':'' %>>Poppins</option>
                  <option value="Outfit" <%= fonts.logo==='Outfit'?'selected':'' %>>Outfit</option>
                  <option value="Inter" <%= fonts.logo==='Inter'?'selected':'' %>>Inter</option>
                  <option value="Raleway" <%= fonts.logo==='Raleway'?'selected':'' %>>Raleway</option>
                  <option value="DM Sans" <%= fonts.logo==='DM Sans'?'selected':'' %>>DM Sans</option>
                </select>
                <div class="font-preview" id="logo-preview" style="font-size:1.2rem;margin-top:8px;font-weight:700">bitkok.com</div>
              </div>
            </div>
            <div class="form-row" style="grid-template-columns:1fr 1fr 1fr">
              <div class="form-group"><label>Başlık Ağırlık</label><select name="fonts.headingWeight"><option value="400" <%= fonts.headingWeight==='400'?'selected':'' %>>Normal (400)</option><option value="600" <%= fonts.headingWeight==='600'?'selected':'' %>>Semi Bold (600)</option><option value="700" <%= fonts.headingWeight==='700'?'selected':'' %>>Bold (700)</option><option value="800" <%= fonts.headingWeight==='800'?'selected':'' %>>Extra Bold (800)</option></select></div>
              <div class="form-group"><label>Gövde Ağırlık</label><select name="fonts.bodyWeight"><option value="300" <%= fonts.bodyWeight==='300'?'selected':'' %>>Light (300)</option><option value="400" <%= fonts.bodyWeight==='400'?'selected':'' %>>Normal (400)</option><option value="500" <%= fonts.bodyWeight==='500'?'selected':'' %>>Medium (500)</option></select></div>
              <div class="form-group"><label>Logo Ağırlık</label><select name="fonts.logoWeight"><option value="600" <%= fonts.logoWeight==='600'?'selected':'' %>>Semi Bold (600)</option><option value="700" <%= fonts.logoWeight==='700'?'selected':'' %>>Bold (700)</option><option value="800" <%= fonts.logoWeight==='800'?'selected':'' %>>Extra Bold (800)</option></select></div>
            </div>
          </div>

          <!-- COLORS -->
          <div class="form-section" style="border-left:3px solid #E0A96D">
            <h3>🎨 Renk Paleti</h3>
            <p style="color:var(--white-60);font-size:0.82rem;margin-bottom:16px">Kurumsal kimlik renklerinizi buradan yönetin. Tüm site otomatik güncellenir.</p>
            <h4 style="font-size:0.85rem;color:var(--sand);margin-bottom:12px">Ana Renkler</h4>
            <div class="color-grid">
              <div class="color-item"><label>Tech Navy (Ana)</label><div class="color-input-wrap"><input type="color" name="colors.primary" value="<%= colors.primary || '#1B263B' %>"><span><%= colors.primary || '#1B263B' %></span></div></div>
              <div class="color-item"><label>Digital Olive</label><div class="color-input-wrap"><input type="color" name="colors.secondary" value="<%= colors.secondary || '#4F6D7A' %>"><span><%= colors.secondary || '#4F6D7A' %></span></div></div>
              <div class="color-item"><label>Bio Sprout (Aksan)</label><div class="color-input-wrap"><input type="color" name="colors.accent" value="<%= colors.accent || '#83C5BE' %>"><span><%= colors.accent || '#83C5BE' %></span></div></div>
              <div class="color-item"><label>Warm Sand (Vurgu)</label><div class="color-input-wrap"><input type="color" name="colors.highlight" value="<%= colors.highlight || '#E0A96D' %>"><span><%= colors.highlight || '#E0A96D' %></span></div></div>
              <div class="color-item"><label>Koyu Arka Plan</label><div class="color-input-wrap"><input type="color" name="colors.primaryDark" value="<%= colors.primaryDark || '#0F1A2B' %>"><span><%= colors.primaryDark || '#0F1A2B' %></span></div></div>
            </div>
            <h4 style="font-size:0.85rem;color:var(--sand);margin:20px 0 12px">Metin Renkleri</h4>
            <div class="color-grid">
              <div class="color-item"><label>Başlık</label><div class="color-input-wrap"><input type="color" name="colors.textHeading" value="<%= colors.textHeading || '#FFFFFF' %>"><span><%= colors.textHeading || '#FFFFFF' %></span></div></div>
              <div class="color-item"><label>Link Rengi</label><div class="color-input-wrap"><input type="color" name="colors.textLink" value="<%= colors.textLink || '#83C5BE' %>"><span><%= colors.textLink || '#83C5BE' %></span></div></div>
              <div class="color-item"><label>Bölüm Etiketi</label><div class="color-input-wrap"><input type="color" name="colors.sectionLabelColor" value="<%= colors.sectionLabelColor || '#83C5BE' %>"><span><%= colors.sectionLabelColor || '#83C5BE' %></span></div></div>
              <div class="color-item"><label>Sayaç Rengi</label><div class="color-input-wrap"><input type="color" name="colors.counterColor" value="<%= colors.counterColor || '#83C5BE' %>"><span><%= colors.counterColor || '#83C5BE' %></span></div></div>
            </div>
            <h4 style="font-size:0.85rem;color:var(--sand);margin:20px 0 12px">Buton Renkleri</h4>
            <div class="color-grid">
              <div class="color-item"><label>Birincil Buton BG</label><div class="color-input-wrap"><input type="color" name="colors.btnPrimaryBg" value="<%= colors.btnPrimaryBg || '#E0A96D' %>"><span><%= colors.btnPrimaryBg || '#E0A96D' %></span></div></div>
              <div class="color-item"><label>Birincil Buton Metin</label><div class="color-input-wrap"><input type="color" name="colors.btnPrimaryText" value="<%= colors.btnPrimaryText || '#1B263B' %>"><span><%= colors.btnPrimaryText || '#1B263B' %></span></div></div>
              <div class="color-item"><label>İkincil Buton Metin</label><div class="color-input-wrap"><input type="color" name="colors.btnSecondaryText" value="<%= colors.btnSecondaryText || '#83C5BE' %>"><span><%= colors.btnSecondaryText || '#83C5BE' %></span></div></div>
              <div class="color-item"><label>İkincil Buton Çerçeve</label><div class="color-input-wrap"><input type="color" name="colors.btnSecondaryBorder" value="<%= colors.btnSecondaryBorder || '#83C5BE' %>"><span><%= colors.btnSecondaryBorder || '#83C5BE' %></span></div></div>
            </div>
          </div>

          <!-- TYPOGRAPHY -->
          <div class="form-section" style="border-left:3px solid #4F6D7A">
            <h3>📐 Tipografi Ayarları</h3>
            <div class="form-row" style="grid-template-columns:1fr 1fr 1fr">
              <div class="form-group"><label>Temel Font Boyutu (px)</label><input type="number" name="typography.baseFontSize" value="<%= typo.baseFontSize || '16' %>" min="12" max="24"></div>
              <div class="form-group"><label>H1 Boyut (rem)</label><input type="number" name="typography.h1Size" value="<%= typo.h1Size || '3.5' %>" step="0.1" min="1" max="6"></div>
              <div class="form-group"><label>H2 Boyut (rem)</label><input type="number" name="typography.h2Size" value="<%= typo.h2Size || '2.8' %>" step="0.1" min="1" max="5"></div>
            </div>
            <div class="form-row" style="grid-template-columns:1fr 1fr 1fr">
              <div class="form-group"><label>Satır Yüksekliği</label><input type="number" name="typography.lineHeight" value="<%= typo.lineHeight || '1.6' %>" step="0.1" min="1" max="3"></div>
              <div class="form-group"><label>Başlık Satır Yüksekliği</label><input type="number" name="typography.headingLineHeight" value="<%= typo.headingLineHeight || '1.1' %>" step="0.05" min="0.8" max="2"></div>
              <div class="form-group"><label>Nav Font Boyut (rem)</label><input type="number" name="typography.navFontSize" value="<%= typo.navFontSize || '0.9' %>" step="0.05" min="0.7" max="1.5"></div>
            </div>
            <div class="form-row">
              <div class="form-group"><label>Başlık Dönüşümü</label><select name="typography.headingTransform"><option value="uppercase" <%= typo.headingTransform==='uppercase'?'selected':'' %>>BÜYÜK HARF</option><option value="capitalize" <%= typo.headingTransform==='capitalize'?'selected':'' %>>İlk Harf Büyük</option><option value="none" <%= typo.headingTransform==='none'?'selected':'' %>>Normal</option></select></div>
              <div class="form-group"><label>Etiket Harf Aralığı (px)</label><input type="number" name="typography.labelLetterSpacing" value="<%= typo.labelLetterSpacing || '3' %>" min="0" max="10"></div>
            </div>
          </div>

          <!-- SPACING -->
          <div class="form-section">
            <h3>📏 Boşluk ve Düzen</h3>
            <div class="form-row" style="grid-template-columns:1fr 1fr 1fr">
              <div class="form-group"><label>Container Genişlik (px)</label><input type="number" name="spacing.containerMaxWidth" value="<%= spacing.containerMaxWidth || '1200' %>" min="900" max="1600" step="50"></div>
              <div class="form-group"><label>Bölüm Padding Y (px)</label><input type="number" name="spacing.sectionPaddingY" value="<%= spacing.sectionPaddingY || '100' %>" min="40" max="200" step="10"></div>
              <div class="form-group"><label>Kart Padding (px)</label><input type="number" name="spacing.cardPadding" value="<%= spacing.cardPadding || '36' %>" min="16" max="60"></div>
            </div>
            <div class="form-row">
              <div class="form-group"><label>Grid Gap (px)</label><input type="number" name="spacing.gap" value="<%= spacing.gap || '24' %>" min="8" max="48"></div>
              <div class="form-group"><label>Navbar Yükseklik (px)</label><input type="number" name="spacing.navbarHeight" value="<%= spacing.navbarHeight || '70' %>" min="50" max="100"></div>
            </div>
          </div>

          <!-- BORDERS -->
          <div class="form-section">
            <h3>🔲 Köşe Yuvarlaklığı</h3>
            <div class="form-row" style="grid-template-columns:1fr 1fr 1fr 1fr">
              <div class="form-group"><label>Küçük (px)</label><input type="range" name="borders.radiusSmall" value="<%= borders.radiusSmall || '8' %>" min="0" max="24" class="range-input"><span class="range-value"><%= borders.radiusSmall || '8' %>px</span></div>
              <div class="form-group"><label>Orta (px)</label><input type="range" name="borders.radiusMedium" value="<%= borders.radiusMedium || '12' %>" min="0" max="32" class="range-input"><span class="range-value"><%= borders.radiusMedium || '12' %>px</span></div>
              <div class="form-group"><label>Büyük (px)</label><input type="range" name="borders.radiusLarge" value="<%= borders.radiusLarge || '20' %>" min="0" max="40" class="range-input"><span class="range-value"><%= borders.radiusLarge || '20' %>px</span></div>
              <div class="form-group"><label>Buton (px)</label><input type="range" name="borders.radiusButton" value="<%= borders.radiusButton || '50' %>" min="0" max="50" class="range-input"><span class="range-value"><%= borders.radiusButton || '50' %>px</span></div>
            </div>
          </div>

          <!-- EFFECTS -->
          <div class="form-section">
            <h3>✨ Efektler ve Animasyonlar</h3>
            <div class="form-row" style="grid-template-columns:1fr 1fr 1fr">
              <div class="form-group"><label>Geçiş Hızı (sn)</label><input type="number" name="effects.transitionSpeed" value="<%= effects.transitionSpeed || '0.3' %>" step="0.05" min="0.1" max="1"></div>
              <div class="form-group"><label>Hover Büyütme</label><input type="number" name="effects.hoverScale" value="<%= effects.hoverScale || '1.05' %>" step="0.01" min="1" max="1.2"></div>
              <div class="form-group"><label>Kart Hover Kaldırma (px)</label><input type="number" name="effects.cardHoverLift" value="<%= effects.cardHoverLift || '6' %>" min="0" max="20"></div>
            </div>
            <div class="form-row" style="grid-template-columns:1fr 1fr 1fr">
              <div class="form-group"><label>Gölge Yoğunluğu</label><input type="range" name="effects.shadowIntensity" value="<%= (parseFloat(effects.shadowIntensity)||0.3)*100 %>" min="0" max="100" class="range-input" data-divide="100"><span class="range-value"><%= effects.shadowIntensity || '0.3' %></span></div>
              <div class="form-group"><label>Cam Bulanıklık (px)</label><input type="number" name="effects.glassBlur" value="<%= effects.glassBlur || '20' %>" min="0" max="40"></div>
              <div class="form-group"><label>Gradient Açısı (°)</label><input type="number" name="effects.gradientAngle" value="<%= effects.gradientAngle || '135' %>" min="0" max="360"></div>
            </div>
          </div>

          <button type="submit" class="btn-save">💾 Tasarımı Kaydet</button>
        </form>

      <!-- SECURITY -->
      <% } else if (section === 'security') { %>
        <!-- Şifre Değiştirme -->
        <div class="form-section" style="border-left:3px solid #e74c3c;max-width:600px">
          <h3>🔒 Şifre Değiştir</h3>
          <p style="color:var(--white-60);font-size:0.82rem;margin-bottom:20px">Şifrenizi düzenli olarak değiştirmeniz güvenliğiniz için önemlidir. Minimum 6 karakter kullanın.</p>
          <form id="changePasswordForm">
            <div class="form-group">
              <label>Mevcut Şifre</label>
              <div class="input-wrap" style="background:rgba(255,255,255,0.03);border:1px solid var(--white-10);border-radius:8px;padding:0 14px">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" style="color:var(--white-60);flex-shrink:0"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                <input type="password" id="currentPassword" name="currentPassword" placeholder="Mevcut şifrenizi girin" required style="flex:1;padding:10px 8px;background:none;border:none;color:var(--white);font-size:0.9rem;outline:none">
              </div>
            </div>
            <div class="form-group">
              <label>Yeni Şifre</label>
              <div class="input-wrap" style="background:rgba(255,255,255,0.03);border:1px solid var(--white-10);border-radius:8px;padding:0 14px">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" style="color:var(--white-60);flex-shrink:0"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                <input type="password" id="newPassword" name="newPassword" placeholder="Yeni şifrenizi girin (min 6 karakter)" required minlength="6" style="flex:1;padding:10px 8px;background:none;border:none;color:var(--white);font-size:0.9rem;outline:none">
              </div>
            </div>
            <div class="form-group">
              <label>Yeni Şifre Tekrar</label>
              <div class="input-wrap" style="background:rgba(255,255,255,0.03);border:1px solid var(--white-10);border-radius:8px;padding:0 14px">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" style="color:var(--white-60);flex-shrink:0"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22,4 12,14.01 9,11.01"/></svg>
                <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Yeni şifrenizi tekrar girin" required minlength="6" style="flex:1;padding:10px 8px;background:none;border:none;color:var(--white);font-size:0.9rem;outline:none">
              </div>
            </div>
            <div id="passwordStrength" style="margin-bottom:16px"></div>
            <button type="submit" class="btn-save" style="background:#e74c3c">🔒 Şifreyi Güncelle</button>
          </form>
        </div>

        <!-- Session Bilgisi -->
        <div class="form-section" style="max-width:600px">
          <h3>📊 Oturum Bilgileri</h3>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
            <div style="background:var(--white-05);padding:16px;border-radius:8px;border:1px solid var(--white-10)">
              <div style="font-size:0.75rem;color:var(--white-60);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px">Kullanıcı</div>
              <div style="font-weight:600;color:var(--sprout)"><%= admin.username %></div>
            </div>
            <div style="background:var(--white-05);padding:16px;border-radius:8px;border:1px solid var(--white-10)">
              <div style="font-size:0.75rem;color:var(--white-60);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px">Rol</div>
              <div style="font-weight:600;color:var(--sand)"><%= admin.role || 'admin' %></div>
            </div>
          </div>
        </div>

        <!-- Güvenlik Önerileri -->
        <div class="form-section" style="max-width:600px;border-left:3px solid var(--sprout)">
          <h3>🛡️ Güvenlik Durumu</h3>
          <div style="display:flex;flex-direction:column;gap:12px">
            <div style="display:flex;align-items:center;gap:12px;padding:12px;background:rgba(46,204,113,0.08);border-radius:8px;border:1px solid rgba(46,204,113,0.2)">
              <svg viewBox="0 0 24 24" fill="none" stroke="#2ecc71" stroke-width="2" width="20" height="20"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22,4 12,14.01 9,11.01"/></svg>
              <span style="font-size:0.85rem;color:rgba(255,255,255,0.8)">Helmet güvenlik başlıkları aktif</span>
            </div>
            <div style="display:flex;align-items:center;gap:12px;padding:12px;background:rgba(46,204,113,0.08);border-radius:8px;border:1px solid rgba(46,204,113,0.2)">
              <svg viewBox="0 0 24 24" fill="none" stroke="#2ecc71" stroke-width="2" width="20" height="20"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22,4 12,14.01 9,11.01"/></svg>
              <span style="font-size:0.85rem;color:rgba(255,255,255,0.8)">Şifreler bcrypt ile hashlenmiş</span>
            </div>
            <div style="display:flex;align-items:center;gap:12px;padding:12px;background:rgba(46,204,113,0.08);border-radius:8px;border:1px solid rgba(46,204,113,0.2)">
              <svg viewBox="0 0 24 24" fill="none" stroke="#2ecc71" stroke-width="2" width="20" height="20"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22,4 12,14.01 9,11.01"/></svg>
              <span style="font-size:0.85rem;color:rgba(255,255,255,0.8)">Brute-force koruması aktif (5 deneme / 15 dk)</span>
            </div>
            <div style="display:flex;align-items:center;gap:12px;padding:12px;background:rgba(46,204,113,0.08);border-radius:8px;border:1px solid rgba(46,204,113,0.2)">
              <svg viewBox="0 0 24 24" fill="none" stroke="#2ecc71" stroke-width="2" width="20" height="20"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22,4 12,14.01 9,11.01"/></svg>
              <span style="font-size:0.85rem;color:rgba(255,255,255,0.8)">Session HttpOnly + SameSite cookie koruması</span>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Toast Notification -->
      <div class="toast" id="toast"></div>
    </div>
